# ====================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# 🚀 HOW TO SETUP:
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with YOUR local paths/values
#
# 3. IMPORTANT: .env is in .gitignore - NEVER commit it!
#    Only .env.example goes to GitHub!
#
# ====================================================================

# DATA DIRECTORIES
# ================
# Path to your local raw data files (can be absolute or relative)
# Examples:
#   - Relative: ./data/raw
#   - Absolute macOS: /Users/username/Documents/data
#   - Absolute Linux: /home/username/data
#   - Absolute Windows: C:\Users\username\Documents\data
DATA_RAW_DIR=./data/raw

# Path where processed data will be saved
DATA_PROCESSED_DIR=./data/processed

# ANALYSIS PARAMETERS
# ===================
# Minimum year for analysis (change if needed)
MIN_YEAR=2000

# LOGGING (Optional)
# ==================
# Set logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# DATABASE CONFIGURATION (Optional - uncomment if using database)
# =============================================================
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=education_db
# DATABASE_USER=admin
# DATABASE_PASSWORD=secure_password

# API KEYS (Optional - NEVER commit real keys!)
# ==============================================
# API_KEY_WORLDBANK=your_api_key_here
# API_KEY_KAGGLE=your_kaggle_api_key_here

# ====================================================================
# ⚠️ SECURITY REMINDER:
# - Never commit .env with real passwords/keys!
# - .env should be in .gitignore
# - Use .env.example to document which variables are needed
# - Ask team leads for shared credentials (use password manager)
# ==================================================================== 
